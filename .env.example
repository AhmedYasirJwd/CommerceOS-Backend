# ------------------------------------------------------------
# CommerceOS Backend - environment variables
# Copy to .env and fill in. NEVER commit .env.
# ------------------------------------------------------------

# Runtime: development | production | test
NODE_ENV=development

# Local HTTP port (ignored on Vercel)
PORT=3001

# Supabase project URL (Project Settings -> API -> Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key (Project Settings -> API -> service_role).
# BACKEND ONLY. Never expose this to the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Allowed frontend origin(s) for CORS. Comma-separate multiple origins.
# In development http://localhost:3000 is always allowed.
FRONTEND_URL=http://localhost:3000

# Authentication mode:
#   demo     - no login; every request is scoped to DEFAULT_STORE_ID
#   supabase - requires "Authorization: Bearer <Supabase access token>" and
#              resolves the store through users/store_members
AUTH_MODE=demo

# Store used in demo mode (and by `npm run seed`). `npm run seed` prints
# this ID if you leave it empty on the first run.
DEFAULT_STORE_ID=
